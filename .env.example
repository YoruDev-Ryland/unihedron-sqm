# Host port for the web interface. The container always defaults to 7942.
SQM_WEB_PORT=7942
PUBLIC_URL=http://localhost:7942
TZ=UTC

# Leave blank to select a discovered device in the web interface.
SQM_TRANSPORT=
SQM_HOST=
SQM_PORT=
SQM_SERIAL_DEVICE=
SQM_BAUD_RATE=
# Host group ID that owns the USB serial device; used by the optional mapping.
SQM_SERIAL_GID=20
SQM_POLL_INTERVAL=60
SQM_CONNECT_TIMEOUT=5
SQM_READ_TIMEOUT=120
SQM_RETENTION_DAYS=0

# Pin a release instead of following the latest image.
# SQM_IMAGE=ghcr.io/yorudev-ryland/unihedron-sqm:1.0.0

# Optional first-start overrides. Blank values are generated automatically.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
API_KEY=
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=
MAX_UPLOAD_MB=20

# Observing site, for astronomical darkness and the moon on the year map.
# SQM_SITE_LATITUDE=
# SQM_SITE_LONGITUDE=

# MQTT and Home Assistant. Leave the host blank to turn MQTT off.
# SQM_MQTT_HOST=
# SQM_MQTT_PORT=1883
# SQM_MQTT_USERNAME=
# SQM_MQTT_PASSWORD=
# SQM_MQTT_TLS=false
# SQM_MQTT_BASE_TOPIC=sqm
# SQM_MQTT_DISCOVERY=true
# SQM_MQTT_DISCOVERY_PREFIX=homeassistant

# Serve /metrics without the API key (trusted networks only).
# SQM_PROMETHEUS_PUBLIC=false

# Offline alerts by webhook, ntfy, or Gotify.
# SQM_ALERTS_URL=
# SQM_ALERTS_FORMAT=json
# SQM_ALERTS_OFFLINE_HOURS=2
